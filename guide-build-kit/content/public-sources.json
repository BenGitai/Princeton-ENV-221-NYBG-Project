    "plant-invaders": {
      "type": "pdf",
      "file": "sources/public/plant-invaders-mid-atlantic-2010.pdf",
      "cite": "Swearingen, Slattery, Reshetiloff & Zwicker 2010, Plant Invaders of Mid-Atlantic Natural Areas, 4th ed., National Park Service & U.S. Fish and Wildlife Service",
      "url": "https://www.invasive.org/alien/pubs/midatlantic/",
      "rights": "U.S. government work, public domain",
      "printed_page_offset": -2,
      "drop_lines": [
        "^\\s*\\d{1,3}\\s*$",
        "^\\s*[A-Z]\\s*$",
        "^\\s*_+\\s*$",
        "^\\s*(GRASSES & SEDGES|HERBACEOUS FORBS|SHRUBS|TREES|VINES|AQUATIC PLANTS)\\s*$"
      ],
      "drop_text": [
        "Bill Johnson",
        "James H. Miller, USDA FS",
        "Chris Evans, River to River CWMA",
        "Robert Vidéki, Doronicum Kft.",
        "GRASSES & SEDGES",
        "HERBACEOUS FORBS",
        "_____"
      ],
      "drop_regex": [
        "\\s{4,}[A-Z]\\s*$"
      ],
      "dehyphenate": true,
      "joins": {
        "An- thocharis": "Anthocharis",
        "but- terfly": "butterfly",
        "mus- tard": "mustard"
      }
    },
